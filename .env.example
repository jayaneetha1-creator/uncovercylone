# ====================================================================
# UNCOVERCEYLON CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and configure your production values.
# ====================================================================

# Database Configuration (mysql | sqlite)
DB_TYPE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=uncoverceylon
MYSQL_PASSWORD=change_this_to_a_secure_mysql_password
MYSQL_DATABASE=uncoverceylon

# Authentication & Sessions
SESSION_SECRET=create_a_64_character_random_string_here_for_sessions
OWNER_EMAIL=owner@uncoverceylon.com
OWNER_INITIAL_PASSWORD=TemporarySecureOwnerPassword2026!

# SMTP Mailer (Default: Free Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_google_app_password
SMTP_FROM="UncoverCeylon <no-reply@uncoverceylon.com>"

# Google OAuth 2.0 (Optional - Enabled automatically when provided)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Gemini AI Integration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Environment
NODE_ENV=production
